```css
*{
    margin:0;
    padding:0;
    box-sizing:border-box;
    font-family:Arial,sans-serif;
}

body{
    background:#f5f5f5;
    padding:20px;
}

header{
    background:#ff6b35;
    color:white;
    text-align:center;
    padding:20px;
    border-radius:10px;
    margin-bottom:20px;
}

h2{
    margin:20px 0 10px;
}

.products{
    display:grid;
    grid-template-columns:repeat(auto-fit,minmax(250px,1fr));
    gap:20px;
}

.card{
    background:#fff;
    padding:15px;
    border-radius:10px;
    text-align:center;
    box-shadow:0 2px 8px rgba(0,0,0,.15);
}

.card h3{
    margin:10px 0;
}

.card p{
    margin:8px 0;
}

input{
    width:60px;
    padding:5px;
    text-align:center;
}

button{
    margin-top:10px;
    padding:10px 15px;
    background:#ff6b35;
    color:#fff;
    border:none;
    border-radius:5px;
    cursor:pointer;
}

button:hover{
    background:#e55